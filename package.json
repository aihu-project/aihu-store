{
  "name": "@aihu/store",
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom",
    "check:lint": "biome ci .",
    "check:ci": "bun run check:lint && bun run typecheck && bun run test && bun run build && bun run pack:check",
    "pack:check": "bun scripts/check-pack.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aihu/context": "^0.2.0",
    "@aihu/signals": "^0.5.1"
  },
  "description": "Pinia-style global stores on aihu signals — defineStore, SSR-safe per-request instances, registry-based serialize/hydrate, plugins.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu-store.git"
  },
  "homepage": "https://github.com/aihu-project/aihu-store#readme",
  "bugs": "https://github.com/aihu-project/aihu-store/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/bun": "^1.3.0",
    "@types/node": "^20.16.5",
    "jsdom": "^25.0.1",
    "rolldown": "^1.0.0-rc.17",
    "rolldown-plugin-dts": "^0.23.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
